<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VmPing.Desktop" x:Class="VmPing.Desktop.HostHistoryWindow" Title="Histórico de latência" Width="980" Height="560" MinWidth="640" MinHeight="380" WindowStartupLocation="CenterOwner" Icon="/Assets/vmping.ico" Background="{DynamicResource PageBackground}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,14">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Spacing="2">
        <TextBlock x:Name="HostTitle" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="HostAddress" Classes="muted" FontSize="11"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="quiet range" Tag="1" Click="RangeClick">1 h</Button>
        <Button Classes="quiet range" Tag="6" Click="RangeClick">6 h</Button>
        <Button Classes="quiet range" Tag="24" Click="RangeClick">24 h</Button>
        <Button Classes="quiet range" Tag="168" Click="RangeClick">7 dias</Button>
        <Button Classes="" Click="RefreshClick" Margin="8,0,0,0">Atualizar</Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10" Margin="0,0,0,10">
      <Border Classes="stat"><StackPanel Spacing="2"><TextBlock Classes="caption" Text="DISPONIBILIDADE"/><TextBlock x:Name="Availability" Text="—" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Classes="stat" Grid.Column="1"><StackPanel Spacing="2"><TextBlock Classes="caption" Text="PERDA"/><TextBlock x:Name="LossValue" Text="—" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Classes="stat" Grid.Column="2"><StackPanel Spacing="2"><TextBlock Classes="caption" Text="MÉDIA"/><TextBlock x:Name="AverageValue" Text="—" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Classes="stat" Grid.Column="3"><StackPanel Spacing="2"><TextBlock Classes="caption" Text="PIOR"/><TextBlock x:Name="MaximumValue" Text="—" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Classes="stat" Grid.Column="4"><StackPanel Spacing="2"><TextBlock Classes="caption" Text="SONDAGENS"/><TextBlock x:Name="SentValue" Text="—" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Classes="panel" Padding="8">
      <Grid>
        <local:HistoryChart x:Name="Chart"/>
        <TextBlock x:Name="EmptyMessage" Classes="muted" Text="Sem dados neste período. As sondagens são gravadas enquanto o host está em monitoramento." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False"/>
      </Grid>
    </Border>
    <TextBlock Grid.Row="3" x:Name="HoverText" Classes="muted" FontSize="11" Margin="0,8,0,0" Text="Passe o mouse no gráfico para ver cada intervalo. Linha: média · faixa: mín–máx · barras vermelhas: perda."/>
  </Grid>
</Window>
